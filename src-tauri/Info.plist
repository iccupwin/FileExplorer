<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged by Tauri into the app's Info.plist. Declaring the supported languages
  lets macOS run the app (and its web view's navigator.language) in Russian
  when that is the system language.
-->
<plist version="1.0">
<dict>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>ru</string>
    </array>
    <key>CFBundleAllowMixedLocalizations</key>
    <true/>
</dict>
</plist>
